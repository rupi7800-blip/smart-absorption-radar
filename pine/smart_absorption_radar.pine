//@version=6
// =====================================================================================
// SMART ABSORPTION RADAR (SAR)  -  Componente A (TradingView)
// -------------------------------------------------------------------------------------
// Indicatore selettivo: segnala setup LONG/SHORT solo quando TUTTE le condizioni sono vere:
//   contesto HTF confermato -> zona valutazione (range giornaliero) -> zona Fibonacci
//   -> primo tentativo fallito -> secondo tentativo fallito (distinto) -> conferma a chiusura
//   -> stop strutturale, target strutturale, R:R minimo, limiti giornalieri.
//
// NOTE DI METODO (leggere):
//  * "Assorbimento" e' una classificazione tecnica basata su evidenze INDIRETTE (OHLCV).
//    Pine NON fornisce order flow, delta, footprint, liquidazioni ne' volume profile:
//    questi dati NON sono simulati e compaiono in "unavailable_sources" nel JSON.
//  * Tutta la logica di stato gira SOLO a barra chiusa (barstate.isconfirmed): nessun ingresso
//    ne' evento su barre in formazione.
//  * HTF: con "solo candele chiuse" attivo si usa request.security(expr[1], lookahead_on),
//    il pattern documentato senza repainting.
//  * Il "blocco giornaliero" e' simulato dall'indicatore sui dati del grafico. NON e' un
//    registro di conto reale: il server deve applicare lo stesso blocco (vedi documentazione).
//  * Nessuna chiave API in questo file. Il token webhook e' un segreto condiviso opzionale.
// =====================================================================================
indicator("Smart Absorption Radar", shorttitle="SAR", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

const string VERSION = "1.0.0"
const string SCHEMA  = "1.0"

// ============================== INPUT ===============================================
const string G_CTX = "1. Contesto multi-timeframe"
string htfMid   = input.timeframe("60",  "TF conferma intermedio", group=G_CTX, tooltip="Default 1 ora. Deve essere >= TF del grafico.")
string htfHigh  = input.timeframe("240", "TF conferma superiore",  group=G_CTX, tooltip="Default 4 ore. Deve essere >= TF intermedio.")
bool   htfConfirmedOnly = input.bool(true, "Solo candele HTF chiuse (no repaint)", group=G_CTX, tooltip="Se attivo usa il valore dell'ultima candela HTF CHIUSA. Se disattivo il contesto puo' cambiare con candele HTF aperte (repainting_risk=true nel JSON).")
int    htfPivLen = input.int(3, "Pivot struttura HTF (barre per lato)", minval=1, group=G_CTX)
int    htfEmaFast = input.int(20, "EMA veloce HTF", minval=2, group=G_CTX)
int    htfEmaSlow = input.int(50, "EMA lenta HTF", minval=3, group=G_CTX)
string ctxMode = input.string("Entrambi allineati", "Regola contesto", options=["Entrambi allineati", "Superiore decide, intermedio non opposto"], group=G_CTX, tooltip="Rialzista/ribassista = struttura (HH/HL o LH/LL) + prezzo e EMA coerenti. Altrimenti EQUILIBRIO: nessun ingresso.")

const string G_VAL = "2. Valutazione (range giornaliero)"
