float  tpFixedR = input.float(2.0, "R fisso (solo modalita' R fisso)", minval=0.5, step=0.1, group=G_TRD)

const string G_RSK = "7. Gestione del capitale"
float  capital = input.float(10000.0, "Capitale (nella valuta del simbolo)", minval=1.0, group=G_RSK)
