float  underPct = input.float(0.35, "Sottovalutazione: fino a (quota del range)", minval=0.05, maxval=0.49, step=0.05, group=G_VAL)
float  overPct  = input.float(0.65, "Sopravvalutazione: da (quota del range)", minval=0.51, maxval=0.95, step=0.05, group=G_VAL)
float  entryLimit = input.float(0.50, "Limite posizione ingresso (LONG < x, SHORT > 1-x)", minval=0.2, maxval=0.5, step=0.05, group=G_VAL, tooltip="Impedisce ingressi nella meta' sfavorevole del range. Il centro non e' zona privilegiata.")
int    minDayBars = input.int(12, "Barre minime nel giorno", minval=1, group=G_VAL)
float  minDayRangeATR = input.float(2.0, "Range giornaliero minimo (x ATR)", minval=0.5, step=0.5, group=G_VAL)
string sessA = input.session("0000-0800", "Sessione A (es. Asia)", group=G_VAL)
string sessB = input.session("0800-1600", "Sessione B (es. Londra)", group=G_VAL)

const string G_FIB = "3. Swing e Fibonacci"
