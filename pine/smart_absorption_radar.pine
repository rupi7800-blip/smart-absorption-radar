const string G_DBL = "5. Doppio fallimento e conferma"
int    followBars = input.int(1, "Barre di verifica mancata prosecuzione", minval=1, maxval=5, group=G_DBL)
float  followTolATR = input.float(0.10, "Tolleranza prosecuzione (x ATR)", minval=0.0, step=0.05, group=G_DBL)
