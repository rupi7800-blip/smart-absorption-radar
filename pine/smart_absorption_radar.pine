string confirmMode = input.string("Estremo candela", "Conferma finale", options=["Estremo candela", "Meta' candela"], group=G_DBL, tooltip="LONG: chiusura sopra il massimo (o la meta') della candela di assorbimento. SHORT: specchiato. Valutata solo a barra chiusa.")
int    confirmMaxBars = input.int(6, "Finestra di conferma dopo 2o tentativo (barre)", minval=1, group=G_DBL)

const string G_TRD = "6. Ingresso, stop e target"
float  slAtrMargin = input.float(0.25, "Margine stop (x ATR)", minval=0.0, step=0.05, group=G_TRD)
float  maxStopATR = input.float(3.0, "Stop massimo (x ATR)", minval=0.5, step=0.1, group=G_TRD)
float  maxStopPct = input.float(2.0, "Stop massimo (% del prezzo)", minval=0.05, step=0.05, group=G_TRD)
float  minRR = input.float(2.0, "Rapporto rischio/rendimento minimo", minval=0.5, step=0.1, group=G_TRD)
string tpMode = input.string("Livello strutturale piu' vicino", "Modalita' take profit", options=["Livello strutturale piu' vicino", "Swing opposto (Fib 0)", "R fisso"], group=G_TRD, tooltip="Il target NON viene spostato per rispettare il R:R: se non conviene, nessun segnale.")
