float  reboundATR = input.float(1.0, "Rimbalzo minimo tra tentativi (x ATR)", minval=0.0, step=0.1, group=G_DBL, tooltip="Garantisce che i tentativi siano eventi distinti e non lo stesso movimento.")
float  invalTolATR = input.float(0.25, "Invalidazione: chiusura oltre livello (x ATR)", minval=0.0, step=0.05, group=G_DBL)
